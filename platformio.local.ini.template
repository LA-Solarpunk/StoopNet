; Do not modify this file with custom values! Copy this file to "platformio.local.ini"
; and fill in your own values there. .gitignore will ensure that file isn't tracked
;
;   cp platformio.local.ini.template platformio.local.ini
; 
; The copy of this file will store the secrets that are used to set up private channels
; .gitignore will also ensure the file isn't tracked by git and that users don't accidentally
; upload their secrets!
;
; By default, meshcore shows the secrets as hex messages, you need to convert to base64, you can do this
; with echo -n "<your hex key>" | xxd -r -p | openssl base64 -A

[stoop_secrets]
build_flags =
   ; The #stoop chat channel. STOOP_CHANNEL_PSK is the channel's base64 key,
   ; generate one with tools/stoop_channel_keygen.py ("private" for a private
   ; channel, or "hashtag <name>" for a public hashtag channel)
   -D STOOP_CHANNEL_NAME='"#stoop"'
   -D STOOP_CHANNEL_PSK='"bxXnE9cKvnxW6BJ4gcRMTA=="'

   ; Optional: have the device join an existing WiFi network as a client and
   ; serve the web UI over mDNS at http://<CLIENT_WIFI_URL>.local instead of
   ; hosting its own access point. Leave these commented out to keep the
   ; device's normal AP-mode behavior; if the connection attempt fails (or
   ; later drops and can't be reconnected after a few tries) it falls back
   ; to AP mode automatically.
   ; -D CLIENT_WIFI_SSID='"<your wifi ssid>"'
   ; -D CLIENT_WIFI_PW='"<your wifi password>"'
   ; -D CLIENT_WIFI_URL='"<hostname, e.g. stoop-node>"'

   ; Password required on the /admin page to enable/disable the node's
   ; companion radio interfaces (BLE/USB/WiFi), and for OTA updates at /update.
   ; If left commented out, the interfaces can't be enabled/disabled and OTA
   ; is turned off.
   ; -D ADMIN_PASSWORD='"<your admin password>"'
   
   ; generate the pubkey with the stoop_keygen.py script, this is a public key and 
   ; does not need to stay private
   ; -D STOOP_ADMIN_PUBKEY='"<public key>"'
   ; The admin alerts channel. Alerts are authenticated by the STOOP_ADMIN_PUBKEY
   ; signature, so this is normally a public hashtag channel, get its key with
   ;   python3 tools/stoop_channel_keygen.py hashtag "#stoop-alerts"
   -D STOOP_ADMIN_CHANNEL_NAME='"#stoop-alerts"'
   -D STOOP_ADMIN_CHANNEL_PSK='"MRlRXqbpzFM8RYX0Q4ZyhA=="'
