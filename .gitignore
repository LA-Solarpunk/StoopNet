# --- web/ front end (standalone npm package) ------------------------------
# Scoped to web/ on purpose. A framework gitignore pasted in at the repo root
# would glob *.o / *.a / logs across the C++ tree too, and would carry rules
# for frameworks this project does not use (Nuxt, Gatsby, SvelteKit, ...).

# dependencies & caches
web/node_modules/
web/.cache/
web/.eslintcache
web/.stylelintcache
web/.parcel-cache
web/.turbo/

# local secrets -- .env.example is the tracked template
web/.env
web/.env.*
!web/.env.example

# production build output (npm run build); regenerated by prepublishOnly
web/dist/

# markdown vault (web/md) is an Obsidian vault; the editor's own state and
# the vault-local theme (≈50 MB of font binaries) are not source
web/md/.obsidian/

# test output
web/coverage/
web/test-results/
web/playwright-report/
web/.playwright/

# lockfile-adjacent noise
web/*.tgz
web/.pnp.*
